rules_version = '2';

// Reglas de seguridad — PPAM Entre Ríos
// -----------------------------------------------------------------
// Publicar (desde la carpeta firebase):   firebase deploy --only firestore:rules
// Probar antes (desde firebase/pruebas-reglas):   npm test
//
// Quién es quién:
//  · Administrador técnico: hugoescalda@gmail.com (fijo, para no quedar nunca afuera).
//  · Administradores: config/admins.emails — crean campañas y eligen coordinadores.
//  · Coordinadores de una campaña: coordinadores/{campaña}.emails — la configuran y confirman pedidos.
//  · Hermanos habilitados: entran con su link personal (sesión anónima de Firebase, sin Google).
//    hermanos/{id} los carga un coordinador; links/{código} es la llave; sesiones/{uid} ata el celular al hermano.
//    Un celular a la vez: vale la sesión cuyo uid y código coinciden con los del hermano.
//  · La web está cerrada: sin ser hermano habilitado, coordinador, administrador o soporte no se lee nada.
//  · Pedir turnos: el hermano (con su id de hermano) o un coordinador con su cuenta de Google. Cada uno ve SOLO los suyos.
// Los datos personales (nombre, apellido, congregación, celular) están solo en "pedidos"
// y los ven quien pidió y los coordinadores de esa campaña. En "cupos" solo hay ids.
// Las fotos (fotos/…) son del lugar, sin personas reconocibles.

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo cuentas de Google (si algún día se habilita otro método de ingreso, no hereda permisos por el email).
    function conSesion() { return request.auth != null && request.auth.token.email is string && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function mail() { return request.auth.token.email.lower(); }
    function docAdmins() { return /databases/$(database)/documents/config/admins; }
    function esAdmin() {
      return conSesion() && (mail() == 'hugoescalda@gmail.com' ||
        (exists(docAdmins()) && mail() in get(docAdmins()).data.get('emails', [])));
    }
    function esCoord(cid) {
      let d = /databases/$(database)/documents/coordinadores/$(cid);
      return conSesion() && exists(d) && mail() in get(d).data.get('emails', []);
    }
    function gestiona(cid) { return esAdmin() || esCoord(cid); }
    // Equipo de soporte: config/soporte.emails — ven los reportes y los errores (no campañas ni pedidos).
    function esSoporte() {
      let d = /databases/$(database)/documents/config/soporte;
      return esAdmin() || (conSesion() && exists(d) && mail() in get(d).data.get('emails', []));
    }
    function texto(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    // ---- Hermanos habilitados (ingreso con link) ----
    function anonimo() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function docSes() { return /databases/$(database)/documents/sesiones/$(request.auth.uid); }
    function docHer(hid) { return /databases/$(database)/documents/hermanos/$(hid); }
    function sesionVale(s) { let h = get(docHer(s.hid)).data; return h.get('uid', '') == request.auth.uid && h.cod == s.cod && h.get('baja', false) == false; }
    function habilitado() { return anonimo() && exists(docSes()) && sesionVale(get(docSes()).data); }
    function esCoordAlguno() {
      return conSesion() && exists(/databases/$(database)/documents/roles/$(mail())) &&
             get(/databases/$(database)/documents/roles/$(mail())).data.get('campanas', []).size() > 0;
    }
    function staff() { return esAdmin() || esCoordAlguno(); }
    function lector() { return habilitado() || staff() || esSoporte(); }
    // Quién pide turnos: el hermano (su id de hermano) o un coordinador/administrador con su cuenta de Google.
    function puedePedir() { return habilitado() || staff(); }
    function yo() { return anonimo() ? get(docSes()).data.hid : request.auth.uid; }
    function firmaOk(d) { return anonimo() ? !('email' in d) : d.email == mail(); }

    match /config/publico {
      allow read: if lector();
      allow write: if esAdmin();
    }
    match /config/admins {
      allow read, write: if esAdmin();
    }
    match /config/soporte {
      allow read: if esSoporte();
      allow write: if esAdmin();
    }

    // Reportes de problemas: cualquiera los manda (con o sin sesión); los ven Soporte y los administradores.
    match /reportes/{id} {
      function reporteValido(d) {
        return d.keys().hasOnly(['tipo', 'texto', 'pantalla', 'disp', 'ver', 'ultErr', 'celular', 'uid', 'email', 'nombre', 'estado', 'creado']) &&
               d.tipo is string && d.tipo.size() > 0 && d.tipo.size() <= 40 &&
               d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000 &&
               d.estado == 'nuevo' && d.creado is string && d.creado.size() <= 30 &&
               texto(d, 'pantalla', 100) && texto(d, 'disp', 80) && texto(d, 'ver', 20) && texto(d, 'ultErr', 300) && texto(d, 'celular', 30) && texto(d, 'nombre', 80) &&
               (('uid' in d) ? ((conSesion() && d.uid == request.auth.uid && d.email == mail()) || (habilitado() && d.uid == yo() && !('email' in d)))
                             : !('email' in d) && !('nombre' in d));
      }
      allow create: if reporteValido(request.resource.data);
      allow read, delete: if esSoporte();
      allow update: if esSoporte() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizado', 'por']) &&
                       request.resource.data.estado in ['nuevo', 'visto', 'resuelto'];
    }
    // Errores que la página anota sola (sin datos personales).
    match /errores/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'msg', 'pantalla', 'disp', 'ver', 'creado']) &&
                       request.resource.data.tipo in ['js', 'aviso'] && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 300 &&
                       texto(request.resource.data, 'pantalla', 100) && texto(request.resource.data, 'disp', 80) && texto(request.resource.data, 'ver', 20) && texto(request.resource.data, 'creado', 30);
      allow read, delete: if esSoporte();
    }
    // roles/{email}: en qué campañas coordina cada uno (lo lee él mismo para ver el botón "Coordinación").
    match /roles/{correo} {
      allow read: if conSesion() && (mail() == correo || esAdmin());
      allow write: if esAdmin();
    }
    match /coordinadores/{cid} {
      allow read: if esAdmin() || (conSesion() && mail() in resource.data.get('emails', []));
      allow write: if esAdmin();
    }

    match /campanas/{cid} {
      allow read: if lector();
      allow create, delete: if esAdmin();
      allow update: if gestiona(cid);
    }

    // Cupos: cuántos lugares están ocupados en cada turno de cada día. Público y sin datos
    // personales: solo el id de cada cuenta y "p" (pedido) o "c" (confirmado).
    match /cupos/{id} {
      function campana(cid) { return get(/databases/$(database)/documents/campanas/$(cid)).data; }
      function maximo(d) { let c = campana(d.cid); return c.puntos[c.turnos[d.tid].punto].cupo; }
      function idOk(d) { return id == d.cid + '__' + d.fecha + '__' + d.tid; }
      function forma(d) { return d.keys().hasOnly(['cid', 'fecha', 'tid', 'ocupados']) && d.fecha is string && d.fecha.size() == 10 && d.ocupados is map; }
      // Un publicador solo se agrega a sí mismo como "pedido" o se saca (cancelar), y sin pasarse del cupo.
      // Al agregarse tiene que crear su pedido en el mismo envío; al sacarse, borrarlo. Así nadie ocupa lugares sin dejar sus datos.
      function miPedido() { return /databases/$(database)/documents/pedidos/$(id + '__' + yo()); }
      function enFecha(d) { let c = campana(d.cid); return d.fecha >= c.get('desde', '') && d.fecha <= c.get('hasta', '9999-12-31'); }
      function publicador(antes, despues) {
        let quien = yo();
        return puedePedir() && despues.diff(antes).affectedKeys().hasOnly([quien]) &&
               ((quien in despues) ? (despues[quien] == 'p' && !(quien in antes) && existsAfter(miPedido()) && enFecha(request.resource.data))
                               : !existsAfter(miPedido())) &&
               campana(request.resource.data.cid).get('activa', true) == true;
      }
      allow read: if lector();
      allow create: if forma(request.resource.data) && idOk(request.resource.data) && (
                     gestiona(request.resource.data.cid) ||
                     (publicador({}, request.resource.data.ocupados) && request.resource.data.ocupados.size() <= maximo(request.resource.data)));
      allow update: if forma(request.resource.data) &&
                     request.resource.data.cid == resource.data.cid && request.resource.data.fecha == resource.data.fecha && request.resource.data.tid == resource.data.tid && (
                     gestiona(resource.data.cid) ||
                     (publicador(resource.data.ocupados, request.resource.data.ocupados) && request.resource.data.ocupados.size() <= maximo(resource.data)));
      allow delete: if gestiona(resource.data.cid);
    }

    // Fotos de portada y de los puntos: imágenes JPEG achicadas (menos de ~330 KB), públicas.
    // Las sube el coordinador de esa campaña; el id empieza con el de la campaña.
    match /fotos/{id} {
      function fotoValida(d) {
        return d.keys().hasOnly(['cid', 'data', 'creado']) && d.cid is string && id.matches(d.cid + '__[A-Za-z0-9-]+') &&
               d.data is string && d.data.size() < 450000 && d.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }
      allow read: if lector();
      allow create, update: if fotoValida(request.resource.data) && gestiona(request.resource.data.cid) &&
                             (resource == null || resource.data.cid == request.resource.data.cid);
      allow delete: if gestiona(resource.data.cid);
    }

    // Historial (auditoría): quién cambió o borró qué y cuándo. Solo se agregan líneas, firmadas y con la hora del servidor.
    match /auditoria/{id} {
      function lineaOk(d) {
        return d.keys().hasOnly(['cid', 'tipo', 'texto', 'por', 'uid', 'at', 'antes', 'ref', 'de']) &&
               (anonimo() ? d.por == 'link' : d.por == mail()) && d.uid == yo() && d.at == request.time &&
               d.cid is string && d.cid.size() <= 80 &&
               d.tipo is string && d.tipo.size() > 0 && d.tipo.size() <= 30 &&
               d.texto is string && d.texto.size() > 0 && d.texto.size() <= 400 &&
               (!('antes' in d) || d.antes is map) &&
               (!('ref' in d) || (d.ref is string && d.ref.size() <= 120)) &&
               (!('de' in d) || (d.de is string && d.de.size() <= 60));
      }
      // Un publicador solo anota que canceló SU turno, en el mismo envío en que lo borra (ref = id de su pedido).
      function cancelePropio(d) {
        let ped = /databases/$(database)/documents/pedidos/$(d.ref);
        return d.tipo == 'cancelo' && d.keys().hasOnly(['cid', 'tipo', 'texto', 'por', 'uid', 'at', 'ref']) &&
               'ref' in d && d.ref.matches(d.cid + '__.+__' + yo()) &&
               exists(ped) && get(ped).data.uid == yo() && !existsAfter(ped);
      }
      allow create: if (conSesion() || habilitado()) && lineaOk(request.resource.data) && (
                     (request.resource.data.cid == '' && esAdmin()) ||
                     (request.resource.data.cid != '' && (gestiona(request.resource.data.cid) || (puedePedir() && cancelePropio(request.resource.data)))));
      allow read: if conSesion() && (esAdmin() || (resource.data.cid != '' && esCoord(resource.data.cid)));
      // Nadie la cambia; solo el administrador borra líneas de más de 6 meses.
      allow update: if false;
      allow delete: if esAdmin() && resource.data.at < request.time - duration.value(183, 'd');
    }

    // Pedidos: los datos de quien pide un turno.
    match /pedidos/{id} {
      // Nota para el coordinador: opcional, texto de hasta 200 letras.
      function notaOk(d) { return !('nota' in d) || (d.nota is string && d.nota.size() > 0 && d.nota.size() <= 200); }
      // Punto y horario tienen que ser los del turno en la campaña; "creado" es una fecha corta.
      function turnoOk(d) {
        let t = get(/databases/$(database)/documents/campanas/$(d.cid)).data.turnos[d.tid];
        return d.punto == t.punto && d.desde == t.desde && d.hasta == t.hasta && d.creado is string && d.creado.size() <= 30;
      }
      function pedidoValido(d) {
        let cupo = /databases/$(database)/documents/cupos/$(d.cid + '__' + d.fecha + '__' + d.tid);
        return d.keys().hasOnly(['cid', 'fecha', 'tid', 'punto', 'desde', 'hasta', 'uid', 'email', 'nombre', 'apellido', 'congregacion', 'celular', 'estado', 'creado', 'nota']) &&
               notaOk(d) && turnoOk(d) &&
               d.uid == yo() && firmaOk(d) && d.estado == 'pendiente' &&
               id == d.cid + '__' + d.fecha + '__' + d.tid + '__' + yo() &&
               d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60 &&
               d.apellido is string && d.apellido.size() > 0 && d.apellido.size() <= 60 &&
               d.congregacion is string && d.congregacion.size() > 0 && d.congregacion.size() <= 80 &&
               d.celular is string && d.celular.size() >= 8 && d.celular.size() <= 30 &&
               getAfter(cupo).data.ocupados.get(yo(), '') == 'p';
      }
      // El coordinador anota a un hermano que no usa la app: uid "m-…", queda confirmado y marcado como manual.
      function pedidoManual(d) {
        let cupo = /databases/$(database)/documents/cupos/$(d.cid + '__' + d.fecha + '__' + d.tid);
        return d.keys().hasOnly(['cid', 'fecha', 'tid', 'punto', 'desde', 'hasta', 'uid', 'nombre', 'apellido', 'congregacion', 'celular', 'estado', 'creado', 'nota', 'manual', 'por']) &&
               gestiona(d.cid) && notaOk(d) && turnoOk(d) &&
               d.manual == true && d.por == mail() && d.estado == 'confirmado' &&
               d.uid is string && d.uid.matches('m-[a-z0-9]{6,24}') &&
               id == d.cid + '__' + d.fecha + '__' + d.tid + '__' + d.uid &&
               d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60 &&
               d.apellido is string && d.apellido.size() > 0 && d.apellido.size() <= 60 &&
               d.congregacion is string && d.congregacion.size() > 0 && d.congregacion.size() <= 80 &&
               (!('celular' in d) || (d.celular is string && d.celular.size() >= 8 && d.celular.size() <= 30)) &&
               getAfter(cupo).data.ocupados.get(d.uid, '') == 'c';
      }
      allow read: if (puedePedir() && resource.data.uid == yo()) || gestiona(resource.data.cid);
      allow create: if (puedePedir() && pedidoValido(request.resource.data)) || (conSesion() && pedidoManual(request.resource.data));
      // El coordinador confirma o no; el publicador puede volver a pedir si antes no se lo confirmaron.
      allow update: if (
                     (gestiona(resource.data.cid) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizado', 'por']) &&
                      request.resource.data.estado in ['pendiente', 'confirmado', 'rechazado'] &&
                      texto(request.resource.data, 'actualizado', 30) && (!('por' in request.resource.data) || request.resource.data.por == mail() || request.resource.data.por == resource.data.get('por', ''))) ||
                     (puedePedir() && resource.data.uid == yo() && resource.data.estado == 'rechazado' && pedidoValido(request.resource.data)) ||
                     // quien pidió puede cambiar o borrar su nota
                     (puedePedir() && resource.data.uid == yo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota']) && request.resource.data.diff(resource.data).affectedKeys().size() == 1 && notaOk(request.resource.data)));
      // Quien pidió lo borra liberando su lugar en el mismo envío.
      function libero(d) {
        let cupo = /databases/$(database)/documents/cupos/$(d.cid + '__' + d.fecha + '__' + d.tid);
        return !existsAfter(cupo) || !(d.uid in getAfter(cupo).data.ocupados);
      }
      allow delete: if (puedePedir() && resource.data.uid == yo() && libero(resource.data)) || gestiona(resource.data.cid);
    }

    // ---- Hermanos habilitados ----
    // Los carga un coordinador (o un administrador) cuando el comité de servicio de la congregación lo aprobó.
    // Cada uno tiene un código (la llave de su link) y el uid del celular que lo está usando.
    match /hermanos/{hid} {
      function campos(d) {
        return d.keys().hasOnly(['nombre', 'apellido', 'congregacion', 'celular', 'cod', 'uid', 'ultimo', 'disp', 'antes', 'aviso', 'baja', 'creado', 'por', 'porNombre', 'bajaPor', 'bajaAt']) &&
               d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60 &&
               d.apellido is string && d.apellido.size() > 0 && d.apellido.size() <= 60 &&
               d.congregacion is string && d.congregacion.size() > 0 && d.congregacion.size() <= 80 &&
               d.celular is string && d.celular.size() >= 8 && d.celular.size() <= 30 &&
               d.cod is string && d.cod.matches('[A-Z0-9]{8}') &&
               texto(d, 'creado', 30) && texto(d, 'porNombre', 80) && texto(d, 'bajaPor', 120) && texto(d, 'bajaAt', 30) && texto(d, 'disp', 80) &&
               (!('aviso' in d) || d.aviso is bool) && (!('baja' in d) || d.baja is bool);
      }
      // El hermano entra con su link: este celular pasa a ser el suyo (el anterior queda afuera).
      function ingreso() {
        let s = getAfter(docSes()).data;
        return anonimo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'ultimo', 'disp', 'antes', 'aviso']) &&
               request.resource.data.uid == request.auth.uid && request.resource.data.ultimo == request.time &&
               resource.data.get('baja', false) == false && s.hid == hid && s.cod == resource.data.cod &&
               texto(request.resource.data, 'disp', 80) && (!('aviso' in request.resource.data) || request.resource.data.aviso is bool) &&
               (!('antes' in request.resource.data) || request.resource.data.antes is map);
      }
      allow read: if staff() || (anonimo() && exists(docSes()) && get(docSes()).data.hid == hid);
      allow create: if staff() && campos(request.resource.data) && request.resource.data.por == mail() &&
                     !('uid' in request.resource.data) && !('ultimo' in request.resource.data) && request.resource.data.get('baja', false) == false;
      // El coordinador cambia datos, manda un link nuevo (cambia el código y deja afuera al celular) o da de baja.
      allow update: if (staff() && campos(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'apellido', 'congregacion', 'celular', 'cod', 'uid', 'aviso', 'baja', 'bajaPor', 'bajaAt']) &&
                       (request.resource.data.get('uid', null) == null || request.resource.data.get('uid', null) == resource.data.get('uid', null))) ||
                     ingreso();
      allow delete: if esAdmin();
    }
    // links/{código}: lo justo para saludar al hermano antes de entrar. Solo lo lee quien conoce el código.
    match /links/{cod} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if staff() && cod.matches('[A-Z0-9]{8}') &&
                     request.resource.data.keys().hasOnly(['hid', 'nombre', 'congregacion', 'turnos', 'creado', 'por']) &&
                     request.resource.data.por == mail() && request.resource.data.hid is string &&
                     request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60 &&
                     texto(request.resource.data, 'congregacion', 80) && texto(request.resource.data, 'creado', 30) &&
                     (!('turnos' in request.resource.data) || request.resource.data.turnos is int) &&
                     getAfter(docHer(request.resource.data.hid)).data.cod == cod;
      // Al entrar, el link queda marcado como usado (para saludar "Hola de nuevo" en otro celular).
      allow update: if anonimo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado']) &&
                     request.resource.data.usado == true && getAfter(docSes()).data.cod == cod;
      allow delete: if staff();
    }
    // sesiones/{uid}: qué hermano está usando este celular (sesión anónima de Firebase).
    match /sesiones/{sid} {
      allow read: if anonimo() && request.auth.uid == sid;
      allow create, update: if anonimo() && request.auth.uid == sid &&
                             request.resource.data.keys().hasOnly(['hid', 'cod', 'at']) && request.resource.data.at == request.time &&
                             request.resource.data.cod is string && request.resource.data.hid is string &&
                             get(/databases/$(database)/documents/links/$(request.resource.data.cod)).data.hid == request.resource.data.hid &&
                             get(docHer(request.resource.data.hid)).data.cod == request.resource.data.cod &&
                             get(docHer(request.resource.data.hid)).data.get('baja', false) == false;
      allow delete: if false;
    }
  }
}
